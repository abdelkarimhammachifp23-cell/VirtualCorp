# ==========================================
# CONFIGURACION DE LOS TEMPLATES
# ==========================================

DEBIAN_VERSION="13.7.0"

DEBIAN_ISO_FILENAME="debian-13.7.0-amd64-netinst.iso"

DEBIAN_ISO_URL="https://cdimage.debian.org/debian/13.7.0/amd64/iso-cd/debian-13.7.0-amd64-netinst.iso"

ISO_DIR="${PROJECT_ROOT}/artifacts/isos"

TEMPLATE_DIR="${PROJECT_ROOT}/artifacts/templates"

# Nombres de las maquinas
SERVER_TEMPLATE="debian-server-template"
DESKTOP_TEMPLATE="debian-desktop-template"

# Recursos Server
SERVER_RAM=2048
SERVER_CPU=2
SERVER_DISK=20480

# Recursos Desktop
DESKTOP_RAM=4096
DESKTOP_CPU=2
DESKTOP_DISK=30720

# Usuario
TEMPLATE_USER="sysadmin"

# Red definitiva de los templates
TEMPLATE_INTERNAL_NETWORK="privada"
